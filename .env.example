# =============================================================================
# RedInsumos — configuración
#
# Copia este archivo como ".env" y completa los valores:   cp .env.example .env
# El archivo .env contiene secretos: NO lo subas al repositorio ni lo compartas.
# La aplicación valida estas variables al arrancar y se detiene con un mensaje
# claro si falta alguna obligatoria.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) DESARROLLO LOCAL (npm run dev) y scripts ejecutados fuera de Docker
# -----------------------------------------------------------------------------

# [Obligatoria] Conexión a PostgreSQL.
# Formato: postgresql://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE?schema=public
# Si la clave tiene caracteres especiales (@ : / ? #) hay que codificarlos; lo
# más simple es usar una clave solo con letras y números.
# Con Docker Compose NO hace falta tocarla: Compose arma la suya con los datos
# de la sección 2.
DATABASE_URL="postgresql://medired:medired_dev@localhost:5432/medired?schema=public"

# [Solo para pruebas] Base que usa "npm test". Debe terminar en "_test": las
# pruebas la migran y la vacían solas. Nunca apuntes aquí a una base con datos.
DATABASE_URL_TEST="postgresql://medired:medired_dev@localhost:5432/medired_test?schema=public"

# [Opcional] Horas de inactividad tras las que se cierra la sesión (1 a 168).
# Por defecto 12. Además, toda sesión caduca a los 7 días aunque se siga usando.
SESION_HORAS=12

# [Opcional, solo diagnóstico] Con "query" se registran todas las consultas SQL.
# No lo actives en producción: genera mucho volumen de registros.
# PRISMA_LOG=query

# -----------------------------------------------------------------------------
# 2) PRODUCCIÓN CON DOCKER COMPOSE (docker compose up -d)
# -----------------------------------------------------------------------------

# [Obligatoria con Compose] Clave de la base de datos. Usa una larga y aleatoria,
# solo letras y números. Para generar una:   openssl rand -hex 24
# Se fija al crear la base por primera vez; cambiarla después requiere también
# cambiarla dentro de PostgreSQL (ver docs/OPERACION.md).
POSTGRES_PASSWORD=

# [Opcional] Usuario y nombre de la base (los valores por defecto sirven).
# POSTGRES_USER=redinsumos
# POSTGRES_DB=redinsumos

# [Obligatoria para HTTPS] Dominio público del sistema, sin "https://".
# Debe apuntar por DNS a la IP del servidor. Se usa con:
#   docker compose --profile https up -d
# DOMINIO=insumos.miclinica.cl

# [Opcional] Para no escribir "--profile https" en cada comando.
# COMPOSE_PROFILES=https

# [Opcional] Puerto local donde queda la aplicación (solo accesible desde el
# propio servidor; hacia internet se publica por HTTPS con el proxy).
# PUERTO_APP=3000

# -----------------------------------------------------------------------------
# 3) RESPALDOS (scripts/respaldo.sh y servicio "respaldo" de Compose)
# -----------------------------------------------------------------------------

# [Opcional] Días que se conservan los respaldos locales (0 = no borrar nunca).
# RESPALDO_RETENCION_DIAS=14

# [Opcional] Carpeta de destino al ejecutar scripts/respaldo.sh fuera de Docker.
# RESPALDO_DIR=./respaldos

# [Opcional, Compose] Carpeta del servidor donde el servicio "respaldo" deja los
# archivos, y cada cuántos segundos respalda (86400 = una vez al día).
# RESPALDO_DIR_ANFITRION=./respaldos
# RESPALDO_INTERVALO_SEGUNDOS=86400

# -----------------------------------------------------------------------------
# 4) PRIMER ADMINISTRADOR (npm run admin:crear) — alternativa a los argumentos
# -----------------------------------------------------------------------------
# ADMIN_EMAIL=ana@miclinica.cl
# ADMIN_NOMBRE="Ana Pérez"

# Nota: los datos de demostración (npm run db:seed) son solo para desarrollo y
# capacitación. En producción el seed se niega a ejecutarse.
