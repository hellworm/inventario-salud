# Copia este archivo como .env y ajusta los valores.

# En tu computador: 1. En producción: 0 (o bórralo).
DEBUG=1

# Obligatoria en producción. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Sin DATABASE_URL se usa SQLite (archivo db.sqlite3), ideal para empezar.
# Con PostgreSQL (docker compose up -d):
# DATABASE_URL=postgres://inventario:inventario@localhost:5432/inventario

ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
TIME_ZONE=America/Santiago
DIAS_ALERTA_VENCIMIENTO=90
