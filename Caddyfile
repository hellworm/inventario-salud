# Proxy inverso con HTTPS automático para RedInsumos (servicio "caddy" de
# docker-compose.yml, perfil "https").
#
# Caddy obtiene y renueva solo el certificado de Let's Encrypt para {$DOMINIO}
# y redirige HTTP → HTTPS. Requisitos: el dominio debe apuntar (registro DNS A)
# a la IP del servidor y los puertos 80 y 443 deben estar abiertos.

{$DOMINIO:localhost} {
	encode zstd gzip

	# La aplicación ya envía sus cabeceras de seguridad (CSP, HSTS, etc.).
	# Caddy escribe X-Forwarded-For con la IP de quien se conecta y descarta la
	# que mande el cliente; la aplicación la lee con TRUST_PROXY=1 (Compose).
	reverse_proxy app:3000 {
		health_uri /api/salud
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
